# Copy to .env.local (for local dev) and set the same two values in Vercel/Netlify.
# Both are safe to expose in the browser: the anon key only works within the
# database's Row Level Security rules. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
